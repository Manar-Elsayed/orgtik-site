# Copy to .env.local. Without VITE_CMS_API the site uses its packaged content (src/content/snapshot.js).

# The Website Manager's content API and origin (preview frames are accepted only from it).
VITE_CMS_API=http://localhost:3007/api/backend/wm/v2
VITE_WM_ORIGIN=http://localhost:3007

# Customer sign-in, sign-up and checkout use the identity and catalog API inside the Website Manager.
VITE_SUITE_API=http://localhost:3007/api/backend/sos/api
# VITE_SUITE_URL: the OrgTik suite's customer dashboard (SOS), opened after sign-in. Not part of
# this project; leave unset unless you host the suite.
